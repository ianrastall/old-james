<ContentDialog
    x:Class="OldJames.Cards.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:jupiter="using:Jupiter.UI"
    Title="Settings" PrimaryButtonText="Save settings" CloseButtonText="Cancel" DefaultButton="Primary">
    <StackPanel Spacing="16">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ModelPath" Header="Local GGUF model" TextWrapping="NoWrap" />
            <Button Grid.Column="1" Content="Browse" Click="Browse_Click" VerticalAlignment="Bottom" />
        </Grid>
        <TextBlock Text="Euchre has built-in opponents and needs no model. Other multiplayer games use this model for the other seats."
                   Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap" />
        <StackPanel Spacing="12">
            <TextBlock Text="Appearance" Style="{StaticResource JupiterSectionHeadingTextStyle}" />
            <jupiter:AccentColorSetting x:Name="AccentSetting" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
