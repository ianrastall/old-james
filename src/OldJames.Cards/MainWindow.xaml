<Window
    x:Class="OldJames.Cards.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Old James">
    <Grid x:Name="Root" Background="{ThemeResource JupiterWindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>
        <MenuBar>
            <MenuBarItem Title="Game">
                <MenuFlyoutItem Text="New game" Click="NewDeal_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="UndoMenu" Text="Undo" Click="Undo_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Z" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="HintMenu" Text="Hint" Click="Hint_Click" IsEnabled="False">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="H" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Open ruleset folder" Click="OpenRulesets_Click" />
                <MenuFlyoutItem Text="Reload games" Click="Reload_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Settings" Click="Settings_Click" />
            </MenuBarItem>
        </MenuBar>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Padding="16,8">
            <ComboBox x:Name="Games" Width="255" AutomationProperties.Name="Game" SelectionChanged="Games_SelectionChanged" />
            <Button Content="New game" Click="NewDeal_Click" Style="{StaticResource AccentButtonStyle}" />
            <Button x:Name="UndoButton" Content="Undo" Click="Undo_Click" />
            <Button x:Name="HintButton" Content="Hint" Click="Hint_Click" Visibility="Collapsed" />
            <Button Content="Rules" Click="Rules_Click" />
        </StackPanel>
        <StackPanel Grid.Row="2">
            <InfoBar x:Name="Problem" Severity="Error" IsClosable="True" />
            <InfoBar x:Name="SaveProblem" Severity="Warning" IsClosable="True" />
        </StackPanel>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="224" />
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="Felt" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto"
                          AutomationProperties.Name="Card table">
                <StackPanel x:Name="TableRows" Padding="16" Spacing="16" />
            </ScrollViewer>
            <Grid Grid.Column="1" Background="{ThemeResource JupiterSurfaceBrush}" Padding="12" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="ActionHeading" Text="Actions" TextWrapping="Wrap"
                           Style="{StaticResource JupiterPaneHeadingTextStyle}" />
                <ScrollViewer Grid.Row="1" x:Name="ActionScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="HintText" Visibility="Collapsed" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                        <StackPanel x:Name="Actions" Spacing="4" />
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Grid.Row="2" x:Name="LogHeader" Text="Play log" Style="{StaticResource JupiterPaneHeadingTextStyle}" />
                <ScrollViewer x:Name="LogScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="PlayLog" Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </Grid>
        <Grid Grid.Row="4" Padding="12,0" Background="{ThemeResource JupiterSurfaceBrush}">
            <TextBlock x:Name="Status" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       AutomationProperties.LiveSetting="Polite" Style="{StaticResource JupiterCaptionTextStyle}" />
        </Grid>
    </Grid>
</Window>
